      "html": "<div class=\"ds-slip\"><div class=\"ds-slip-body\"><span class=\"ds-av\" style=\"background:#F25A5A\">P</span><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#6f7a8e\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg><span class=\"ds-av ds-av-guest\" style=\"color:#29A3A3;border-color:#29A3A3\">J</span><span class=\"ds-slip-text\"><span class=\"ds-slip-title\">Dlužíš Janě</span><span class=\"ds-slip-amount\">−480 Kč</span></span></div><div class=\"ds-slip-stub\"><span class=\"ds-notch ds-notch-t\"></span><span class=\"ds-notch ds-notch-b\"></span><button class=\"ds-slip-settle\">Vyrovnat</button></div></div>",
